NODE_ENV="production"

DATABASE_HOST="postgres"
DATABASE_PORT="5432"
DATABASE_NAME="september_fit"
DATABASE_USER="september_fit"
REDIS_URL="redis://redis:6379"

PORT="3000"

FIT_WEB_BASE_URL="https://fit.septemberfit.com"
NEXT_PUBLIC_API_BASE_URL="https://api.septemberfit.com/v1"
FIT_API_INTERNAL_URL="http://api:3000/v1"

DASHBOARD_ORIGINS="https://dashboard.septemberfit.com,https://fit.septemberfit.com"
DASHBOARD_COOKIE_DOMAIN=""
DASHBOARD_PUBLIC_URL="https://dashboard.septemberfit.com"

WEBHOOK_SECRET_MASTER_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
WEBHOOK_WORKER_CONCURRENCY="10"

EMAIL_PROVIDER="console"
LOG_LEVEL="info"

TLS_EMAIL="admin@example.com"

SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""
STRIPE_AUTOMATIC_TAX="false"
STRIPE_PORTAL_CONFIGURATION_ID=""
ALLOW_TEST_KEYS_IN_PRODUCTION="false"
MAINTENANCE_INTERVAL_MS="21600000"
WEBHOOK_RECOVERY_INTERVAL_MS="60000"
SEED_DEMO_DATA="false"
